{
  "$schema": "https://schemas.tauri.app/schemas/v2/capabilities.json",
  "identifier": "default",
  "description": "Default capability for Easy Dataset",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "dialog:allow-save",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "store:allow-get",
    "store:allow-set",
    "store:allow-load",
    "store:allow-save"
  ]
}
